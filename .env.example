# Requerido — el servicio se niega a iniciar sin esto
# ---------------------------------------------------------------------------
# Secreto compartido que el orquestador envía como `Authorization: Bearer <token>`.
# El orquestador lo nombra PERSISTENCE_API_TOKEN; este servicio lee ese nombre
# primero y aún acepta el alias heredado (legacy) SERVICE_API_TOKEN.
# NO hay un valor por defecto: un servicio desprotegido no debe arrancar.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
PERSISTENCE_API_TOKEN=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# La aplicación lee los nombres MONGO. En Docker, dentro de la red
# compartida `mired`, el host es `mongo`; las credenciales vienen de D:\Services.
# Para una ejecución local sin Docker, usa mongodb://localhost:27017.
MONGO_URI=mongodb://<usuario>:<clave>@mongo:27017/?authSource=admin
MONGO_DATABASE=pdf_extractext
MONGO_TEXTS_COLLECTION=texts
MONGO_TIMEOUT_MS=5000
# Tiempo máximo total de una operación Mongo, en milisegundos.
# Tiempo máximo esperando respuesta por socket, en milisegundos.
MONGO_SOCKET_TIMEOUT_MS=5000
# Máximo de conexiones simultáneas del pool.
MONGO_MAX_POOL_SIZE=100
# Tiempo durante el que /readyz reutiliza el último ping, en segundos.
MONGO_READINESS_CACHE_TTL_SECONDS=1

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Tamaño máximo aceptado del cuerpo de la solicitud, en bytes. 10 MiB mantiene
# el documento BSON por debajo del límite de 16 MiB
# de MongoDB; los documentos más grandes son rechazados con 413.
MAX_TEXT_BODY_BYTES=10485760

# ---------------------------------------------------------------------------
# Metadata
# ---------------------------------------------------------------------------
APP_NAME=Persistence Microservice
