# Persistence microservice — operational configuration.
# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Required — the service refuses to start without it
# ---------------------------------------------------------------------------
# Shared secret the orchestrator sends as `Authorization: Bearer <token>`.
# There is deliberately NO default: an unprotected service must not boot.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_TOKEN=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=pdf_extractext
MONGO_TEXTS_COLLECTION=texts
MONGO_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Max accepted request body, in bytes. 10 MiB keeps the resulting BSON document
# safely under MongoDB's 16 MiB limit; larger documents are rejected with 413.
MAX_TEXT_BODY_BYTES=10485760

# ---------------------------------------------------------------------------
# Metadata
# ---------------------------------------------------------------------------
APP_NAME=Persistence Microservice
